# =============================================================
# erp-plm-mes-graphrag-agent .env example
# - 실제 값은 .env 파일에 작성하고, .env 파일은 절대 커밋하지 않는다.
# - API Key 등 민감 값은 placeholder 형태로만 본 파일에 둔다.
# =============================================================

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# --- LLM Provider 선택 ---
# 가능한 값: gemini | openai_compatible
LLM_PROVIDER=gemini

# --- Gemini API ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# --- Optional: OpenAI API ---
OPENAI_API_KEY=optional-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --- Optional: 자체 / 오픈소스 LLM (vLLM, Ollama, TGI, LM Studio 등 OpenAI-compatible) ---
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_API_KEY=not-needed-for-local
LOCAL_LLM_MODEL=qwen2.5-7b-instruct

# --- SQLite (MVP synthetic DB) ---
SQLITE_PATH=./backend/.cache/portfolio.db

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-password
NEO4J_DATABASE=neo4j

# --- Synthetic data 위치 ---
SYNTHETIC_DATA_DIR=./data/synthetic

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
